# Application Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cms

# ============================================
# Authentication Configuration (REQUIRED)
# ============================================
# JWT Secret Key - MUST be a strong random string in production
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=your-secret-key-change-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
AUTH_INVITATION_TOKEN_EXPIRE_DAYS=7

# ============================================
# API Configuration
# ============================================
API_TITLE=FastAPI Project
API_VERSION=v1
API_PREFIX=/v1

# ============================================
# Environment Configuration
# ============================================
ENVIRONMENT=local
DEBUG=true

# ============================================
# SMTP Configuration (for email sending)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CMS System
SMTP_USE_TLS=true

# ============================================
# File Storage Configuration
# ============================================
STORAGE_BASE_PATH=static
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=png,jpg,jpeg,gif,webp

# ============================================
# Blog Revalidation Webhook Configuration
# ============================================
BLOG_REVALIDATION_WEBHOOK_SECRET=your-webhook-secret
BLOG_REVALIDATION_WEBHOOK_URL=http://localhost:3000/api/revalidate

# ============================================
# Next.js API Secret (for public access)
# ============================================
NEXT_API_SECRET=your-next-api-secret
